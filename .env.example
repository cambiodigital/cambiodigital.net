# ==============================================================================
# CAMBIO DIGITAL - VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo a `.env` en la raíz de tu hosting o define estas variables
# directamente en las variables de entorno de cPanel / PHP.
# ==============================================================================

# --- ePayco Gateway Configuration ---
# Obtén estas credenciales desde tu cuenta de ePayco > Integraciones > Llaves API
# P_CUST_ID_CLIENTE (ID de comercio en ePayco)
EPAYCO_CUSTOMER_ID=tu_cliente_id_aqui

# P_KEY (Llave secreta para firmar y validar webhooks SHA-256)
EPAYCO_SECRET_KEY=tu_p_key_secreta_aqui

# PUBLIC_KEY (Llave pública para clientes/botones, opcional)
EPAYCO_PUBLIC_KEY=tu_public_key_aqui

# --- Integraciones Opcionales (n8n / CRM / Webhooks) ---
# Si configuras esta URL, cada pago confirmado por ePayco se enviará automáticamente
# a tu flujo de n8n para registrar en CRM, enviar correo de bienvenida o generar factura.
# N8N_PAYMENTS_WEBHOOK_URL=https://n8n.cambiodigital.cloud/webhook/tu-endpoint-de-pagos
